---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Frequently asked questions about scrobbling — Scrobble.dev';
const description = 'Why anime has a separate catalogue facet, how common trackers differ, what portable scrobble records preserve, and how catalogue data can be reused.';
const questions = [
  {
    id: 'anime',
    q: 'Why is anime a separate catalogue facet?',
    a: 'Anime is a separate filter because it helps people find projects that track episodes, specials, split releases, continuing titles and rewatches. It is a navigation choice, not a claim that anime sits outside film or television. A project can appear under anime and another media type.'
  },
  {
    id: 'trackers',
    q: 'How do common tracking projects differ?',
    a: 'Projects differ in media scope, capture method, hosting model and the records they keep. Some receive playback events, some provide a diary, some keep listening history, and some store a self-hosted record across several media.'
  },
  {
    id: 'portable-record',
    q: 'What should a portable scrobble preserve?',
    a: 'A portable record should preserve stable event identity, source-local media identity, event and recorded times, native progress in the medium\'s native unit, provenance (playback vs import vs manual), correction or deletion state, and idempotent deduplication keys.'
  },
  {
    id: 'licensing',
    q: 'Can the Scrobble.dev catalogue be reused commercially?',
    a: 'Yes. Scrobble.dev releases the catalogue under CC0 Public Domain Dedication. Linked projects, repositories and upstream data retain their own terms.'
  },
  {
    id: 'contribute',
    q: 'How can I contribute to the ecosystem?',
    a: 'Use the Scrobble.dev GitHub repository to submit corrections, add new projects, or propose draft specifications. Use the Fasti issue tracker for changes to the reference implementation.'
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://scrobble.dev/faq/#faqpage',
    mainEntity: questions.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a
      }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Scrobble.dev', item: 'https://scrobble.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Frequently Asked Questions', item: 'https://scrobble.dev/faq/' }
    ]
  }
];
---
<BaseLayout {title} {description} type="FAQPage" schema={schema} markdown="/knowledge/faq.md" status="stable" modified="2026-08-31">
  <div class="container-xl">
    <article class="catalogue-hero h-entry" style="margin-bottom: 24px;">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Field guide</a><span aria-hidden="true">/</span><span aria-current="page">FAQ</span></nav>
      <p class="kicker">Frequently asked questions</p>
      <h1 class="p-name">Questions about scrobbling, trackers and portable records.</h1>
      <p class="standfirst e-summary">Start with the practical difference. Follow the project link when an answer depends on current behaviour.</p>
    </article>

    <div class="row g-4" style="margin-bottom: 40px;">
      <div class="col-lg-8">
        <div class="accordion" id="faq-accordion">
          {questions.map((item, idx) => (
            <div class="accordion-item" id={item.id}>
              <h2 class="accordion-header">
                <button
                  class="accordion-button"
                  type="button"
                  aria-expanded="true"
                  aria-controls={`faq-collapse-${idx}`}
                >
                  {item.q}
                </button>
              </h2>
              <div id={`faq-collapse-${idx}`} class="accordion-collapse show">
                <div class="accordion-body">
                  <p>{item.a}</p>
                  {item.id === 'trackers' && (
                    <div class="table-responsive mt-3">
                      <table class="table table-vcenter card-table">
                        <thead>
                          <tr>
                            <th>Project</th>
                            <th>Main scope</th>
                            <th>Typical record</th>
                            <th>Useful when</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr><th><a href="https://github.com/Scrobble-dev/Fasti">Fasti</a></th><td>11 media types</td><td>Library, history and progress</td><td>A local-first, self-hosted cross-media record is required.</td></tr>
                          <tr><th><a href="https://www.last.fm/about/trackmymusic">Last.fm</a></th><td>Music</td><td>Submitted listens</td><td>Players and services submit listening activity.</td></tr>
                          <tr><th><a href="https://listenbrainz.org/">ListenBrainz</a></th><td>Music</td><td>Open listening history</td><td>An open-source service and exportable listening data are required.</td></tr>
                          <tr><th><a href="https://trakt.tv/">Trakt</a></th><td>Film & TV</td><td>History, progress and playback</td><td>Media applications report playback activity.</td></tr>
                          <tr><th><a href="https://simkl.com/">Simkl</a></th><td>Film, TV & Anime</td><td>History, lists and episode state</td><td>One service covers its three advertised media areas.</td></tr>
                          <tr><th><a href="https://letterboxd.com/welcome/">Letterboxd</a></th><td>Film</td><td>Dated diary entry, rating, list</td><td>The task is film logging rather than live playback progress.</td></tr>
                          <tr><th><a href="https://ryot.io/">Ryot</a></th><td>All Media & Fitness</td><td>Multi-media tracking & workouts</td><td>Comprehensive self-hosted tracking with fitness.</td></tr>
                        </tbody>
                      </table>
                    </div>
                  )}
                  {item.id === 'portable-record' && (
                    <ul class="mt-2 mb-0" style="padding-left: 20px; line-height: 1.6;">
                      <li><strong>Stable event identifier:</strong> Content-addressed hash or UUIDv7.</li>
                      <li><strong>Source-local media identity:</strong> MusicBrainz, TMDB, OpenLibrary, or source provider coordinates.</li>
                      <li><strong>Event & recorded times:</strong> ISO 8601 timestamps capturing both the actual playback moment and storage commit.</li>
                      <li><strong>Native progress:</strong> Elapsed seconds, page counts, or episode offset before percentage loss.</li>
                      <li><strong>Provenance:</strong> Explicit indication of capture method (active playback, diary import, batch sync).</li>
                    </ul>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card card-stacked">
          <div class="card-body">
            <h3 class="card-title">Looking for something else?</h3>
            <p class="text-secondary" style="font-size: 13.5px; line-height: 1.5;">
              Explore the source-linked catalogue of 27+ scrobbling tools, read the architecture specifications, or check the friends ring.
            </p>
            <div class="d-flex flex-column gap-2 mt-3">
              <a href="/projects/" class="btn btn-primary w-100">Browse Project Catalogue →</a>
              <a href="/about/" class="btn btn-outline-secondary w-100">Editorial Method & About</a>
              <a href="/friends/" class="btn btn-outline-secondary w-100">Slashfriends (/friends)</a>
              <a href="https://github.com/Scrobble-dev/scrobble.dev/issues/new" class="btn btn-outline-secondary w-100" target="_blank" rel="noopener noreferrer">Submit a Question ↗</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>


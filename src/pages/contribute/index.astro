---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Contribute to Scrobble.dev or Fasti — Scrobble.dev';
const description = 'Add source-backed scrobbling knowledge to Scrobble.dev or bring a reproducible tracking failure, fixture, test or code change to Fasti.';
---
<BaseLayout {title} {description}>
  <div class="shell">
    <section class="hero contribute-hero" aria-labelledby="contribute-title">
      <p class="eyebrow">Contribute</p>
      <h1 id="contribute-title">Contribute to the guide or the software.</h1>
      <p class="lede">Bring evidence to the guide. Bring a reproducible failure to Fasti. The first changes what people know; the second changes what software does.</p>
    </section>

    <section class="section contribution-paths" aria-labelledby="paths">
      <div class="section-intro"><p class="section-label">Two ways in</p><h2 id="paths">Knowledge on one side. Software on the other.</h2></div>
      <div class="row g-4 contribution-lanes">
        <article class="col-lg-6">
          <div class="card h-100">
            <div class="card-body d-flex flex-column">
              <p class="project-type">Scrobble.dev</p>
              <h3 class="card-title">Add or correct knowledge</h3>
              <p class="card-text">Bring a first-party source, a factual summary and one missing or incorrect claim. Project catalogue entries must name the media type, role, capture method, source availability and contribution route.</p>
              <ul><li>Use plain Markdown and stable links.</li><li>Keep one topic or correction per change.</li><li>Separate documented behaviour from interpretation.</li></ul>
              <div class="project-links mt-auto"><a class="btn btn-primary" href="https://github.com/Scrobble-dev/scrobble.dev/issues/new">Suggest a site change</a><a class="btn btn-outline-secondary" href="https://github.com/Scrobble-dev/scrobble.dev">Edit the repository</a></div>
            </div>
          </div>
        </article>
        <article class="col-lg-6">
          <div class="card h-100">
            <div class="card-body d-flex flex-column">
              <p class="project-type">Fasti</p>
              <h3 class="card-title">Fix a tracking failure</h3>
              <p class="card-text">Name the media identity, the observed event, what the software recorded and what should survive a retry, correction, import or export.</p>
              <ul><li>Add an anonymized example or reproducible sequence.</li><li>Name provider identifiers and numbering schemes.</li><li>Include a round-trip test when code changes behaviour.</li></ul>
              <div class="project-links mt-auto"><a class="btn btn-primary" href="https://github.com/Scrobble-dev/Fasti/issues">Browse Fasti issues</a><a class="btn btn-outline-secondary" href="https://github.com/Scrobble-dev/Fasti/blob/dev/CONTRIBUTING.md">Read the contribution guide</a></div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section article contribution-issue" aria-labelledby="issue-title">
      <div class="article-body">
        <p class="section-label">A useful issue</p>
        <h2 id="issue-title">Make the problem reconstructable.</h2>
        <dl class="field-notes card contribution-checklist">
          <div><dt>Context</dt><dd>Media type, player, tracker, integration direction and relevant versions.</dd></div>
          <div><dt>Identity</dt><dd>Provider IDs and titles, with personal account identifiers removed.</dd></div>
          <div><dt>Observed</dt><dd>The event or state that actually occurred.</dd></div>
          <div><dt>Expected</dt><dd>The event or state that should have resulted and why.</dd></div>
          <div><dt>Round trip</dt><dd>What happens after export, repeat synchronization, correction and import.</dd></div>
          <div><dt>Evidence</dt><dd>Logs, API payloads, fixtures, screenshots or documentation sufficient to verify the claim.</dd></div>
        </dl>
      </div>
    </section>

    <p class="reference-note">Knowledge contributions also update the <a href="https://github.com/GoogleCloudPlatform/knowledge-catalog/tree/main/okf">Open Knowledge Format v0.2</a> bundle when a reusable concept changes.</p>
  </div>
</BaseLayout>
